# The server package and the backend packs (a CUDA pack is ~1 GB) are published
# as GitHub Release assets instead of repository content:
#
#   gh release create v0.2.0 dist/cage-server-0.2.0-linux-x64.tar.gz \
#                            dist/cage-backend-*-0.2.0-linux-x64.tar.gz \
#                            dist/cage-0.2.0.vsix
#
# The .vsix is small enough to live in the repository and is committed.
dist/cage-server-*.tar.gz
dist/cage-backend-*.tar.gz
# Superseded 0.1.0 build, kept out of the repo by name as well as by size.
dist/aiwrapper-server-*.tar.gz

# Docker: the user's own secrets, their copy of the package, and the folders
# compose creates for the database and server data.
docker/.env
docker/*.tar.gz
docker/config/
docker/data/
