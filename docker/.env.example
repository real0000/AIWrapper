# Copy to .env and edit. Compose refuses to start if the required ones are unset.

# ── Required ────────────────────────────────────────────────────────────────

# Where your models live on the host. Mounted read-only at /models, and model
# paths in config.xml refer to that: /models/Qwen3-Coder-Next
MODELS_DIR=/mnt/models

# Database. Any non-empty values; they are only used by these two containers.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-aiwrapper

# Control-plane web UI login. An empty password disables authentication.
ADMIN_PASSWORD=change-me-admin

# ── Optional ────────────────────────────────────────────────────────────────

# MYSQL_DATABASE=aiwrapper
# MYSQL_USER=aiwrapper
# ADMIN_USER=admin

# Bearer the control plane presents to the node agent. Only matters if you
# publish the agent port so a control plane elsewhere can drive this node.
# NODE_TOKEN=

# Host ports.
# API_PORT=15963
# WEB_PORT=8088
# AGENT_PORT=15972

# The package in this directory, and the image tag to build.
# PACKAGE=aiwrapper-server-0.1.0-linux-x64.tar.gz
# VERSION=0.1.0

# Shared memory for the container. Raise it if workers die without an error
# while loading a large model.
# SHM_SIZE=8gb
